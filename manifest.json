{
  "manifest_version": 3,
  "name": "Conversation Archive",
  "version": "0.1.0",
  "description": "Personal Instagram and WhatsApp conversation exports. Local files, no quotas, accounts, or billing.",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://*.cdninstagram.com/*",
    "https://*.fbcdn.net/*",
    "https://*.fbsbx.com/*"
  ],
  "action": {
    "default_title": "Archive this conversation"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
